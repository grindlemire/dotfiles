#!/usr/bin/env bash
# repos: one line per local repo under ~/code/<bucket>/<repo>, showing where
# origin lives, the last commit, and anything that needs attention.
#
#   repos          every repo
#   repos <name>   only repos whose folder contains <name> (repos tui, repos alethi/)
#   repos -p       only repos with a problem (flags starting with !)
#   repos -f       fetch every repo's origin first (network)
#   repos -h       this help, plus what every flag means
#
# In a terminal the table is colored and followed by a short legend for the
# flags it shows; piped output is the plain table. NO_COLOR turns color off.
# REPOS_ROOT overrides ~/code.
set -uo pipefail

# flag_help: one plain-English line per flag, used by the legend and -h.
# Flags starting with ! are problems; the rest are just information.
flag_help() {
  cat <<'EOF'
dirty:N|N files changed but not committed
unpushed:N|N commits saved only on this machine, not on the server yet
wt:N|N extra worktrees (side-by-side checkouts) inside this repo
behind:N|this GitHub backup copy is N commits old; git pull before using it
personal-ns|company repo stored under your personal account, not alethi-dev
!unsynced|this GitHub backup has commits GitStack lacks; run gs repo pull-github in the main copy
!orphan|GitHub backup copy with no main copy next to it
!company-code|company repo sitting in personal/; move it to alethi/ or mynqs/
!not-oss|your own or company repo sitting in oss/
!no-remote|personal/ repo with no server copy; push it somewhere or move it to scratch/
!has-remote|scratch/ repo that has a server copy; move it to personal/
!personal-email|company repo would commit with your personal email
!company-email|personal repo would commit with a non-personal email
!wt-outside|a worktree of this repo lives outside its folder
EOF
}

# print_flags prints flag_help lines as an aligned list; with names given,
# only those flags (matched on the part before ":").
print_flags() {
  flag_help | awk -F '|' -v want=" $* " -v color="$color" '
    { name = $1; base = name; sub(/:.*/, "", base) }
    want != "  " && index(want, " " base " ") == 0 { next }
    {
      label = color ? (base ~ /^!/ ? "\033[1;31m" : "\033[33m") name "\033[0m" : name
      pad = ""; for (i = length(name); i < 16; i++) pad = pad " "
      print "  " label pad $2
    }'
}

ROOT="${REPOS_ROOT:-$HOME/code}"
COMPANY_OWNERS=" alethi-dev alethi-co mynqs "
PERSONAL_OWNER="grindlemire"
GLOBAL_EMAIL="$(git config --global user.email 2>/dev/null || true)"

color=0
[ -t 1 ] && [ -z "${NO_COLOR:-}" ] && color=1

problems_only=0
fetch=0
while getopts "pfh" opt; do
  case $opt in
    p) problems_only=1 ;;
    f) fetch=1 ;;
    *)
      sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
      echo
      echo "Flags (! means a problem, the rest are information):"
      print_flags
      exit 0
      ;;
  esac
done
shift $((OPTIND - 1))
filter="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')"

# parse_remote sets host and slug (owner/repo) from a remote URL.
parse_remote() {
  local u="${1%.git}" rest
  case "$u" in
    "")      host=""; slug="" ;;
    git@*)   rest="${u#git@}"; host="${rest%%:*}"; slug="${rest#*:}" ;;
    *://*)   rest="${u#*://}"; rest="${rest#*@}"; host="${rest%%/*}"; slug="${rest#*/}" ;;
    *)       host="path"; slug="$u" ;;
  esac
}

where_of() {
  case "$1" in
    "")            echo "none" ;;
    github.com)    echo "github" ;;
    gitstack.sh)   echo "gitstack" ;;
    localhost*)    echo "sandbox" ;;
    *)             echo "$1" ;;
  esac
}

count() { wc -l | tr -d ' '; }

default_branch() {
  local b
  b="$(git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)" && { echo "${b#origin/}"; return; }
  for b in main master develop; do
    git -C "$1" show-ref --verify --quiet "refs/remotes/origin/$b" && { echo "$b"; return; }
  done
}

rows=""
matched=0
while IFS= read -r gitdir; do
  repo="${gitdir%/.git}"
  rel="${repo#"$ROOT"/}"
  bucket="${rel%%/*}"
  name="${rel##*/}"

  if [ -n "$filter" ]; then
    case "$(printf '%s' "$rel" | tr '[:upper:]' '[:lower:]')" in *"$filter"*) ;; *) continue ;; esac
  fi
  matched=1

  [ "$fetch" = 1 ] && git -C "$repo" fetch --quiet origin 2>/dev/null

  parse_remote "$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
  where="$(where_of "$host")"
  owner="${slug%%/*}"
  last="$(git -C "$repo" log -1 --format=%cs 2>/dev/null || true)"
  flags=""
  add() { flags="$flags $1"; }

  unpushed="$(git -C "$repo" log --oneline --branches --not --remotes 2>/dev/null | count)"
  [ "$unpushed" != 0 ] && add "unpushed:$unpushed"

  if [ "$bucket" != archive ]; then
    dirty="$(git -C "$repo" status --porcelain 2>/dev/null | count)"
    [ "$dirty" != 0 ] && add "dirty:$dirty"

    wts="$(git -C "$repo" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | tail -n +2)"
    if [ -n "$wts" ]; then
      add "wt:$(printf '%s\n' "$wts" | count)"
      printf '%s\n' "$wts" | grep -qv "^$repo/" && add "!wt-outside"
    fi

    email="$(git -C "$repo" config user.email 2>/dev/null || true)"
    case "$bucket" in
      alethi|mynqs)
        [ "$owner" = "$PERSONAL_OWNER" ] && add "personal-ns"
        [ -n "$GLOBAL_EMAIL" ] && [ "$email" = "$GLOBAL_EMAIL" ] && add "!personal-email"
        ;;
      personal)
        case "$COMPANY_OWNERS" in *" $owner "*) [ -n "$owner" ] && add "!company-code" ;; esac
        [ "$where" = none ] && add "!no-remote"
        [ -n "$GLOBAL_EMAIL" ] && [ "$email" != "$GLOBAL_EMAIL" ] && add "!company-email"
        ;;
      oss)
        case "$COMPANY_OWNERS $PERSONAL_OWNER " in *" $owner "*) [ -n "$owner" ] && add "!not-oss" ;; esac
        ;;
      scratch)
        [ "$where" != none ] && add "!has-remote"
        ;;
    esac

    # A <repo>-github folder is the GitHub fallback clone of <repo> next to it.
    case "$name" in
      *-github)
        primary="${repo%-github}"
        if [ ! -d "$primary/.git" ]; then
          add "!orphan"
        else
          tip="$(git -C "$repo" rev-parse HEAD 2>/dev/null)"
          branch="$(git -C "$repo" branch --show-current 2>/dev/null)"
          [ -z "$branch" ] && branch="$(default_branch "$primary")"
          if ! git -C "$primary" cat-file -e "$tip^{commit}" 2>/dev/null; then
            add "!unsynced"
          elif git -C "$primary" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
            behind="$(git -C "$primary" rev-list --count "$tip..origin/$branch" 2>/dev/null || echo 0)"
            [ "$behind" != 0 ] && add "behind:$behind"
          fi
        fi
        ;;
    esac
  fi

  flags="${flags# }"
  [ "$problems_only" = 1 ] && case "$flags" in *'!'*) ;; *) continue ;; esac
  rows="$rows$rel	$where	${slug:--}	${last:--}	${flags:--}
"
done < <(find "$ROOT" -mindepth 2 -maxdepth 4 \
           \( -name .worktrees -o -name node_modules -o -name .claude \) -prune -o \
           -name .git -type d -print -prune 2>/dev/null | sort)

if [ "$matched" = 0 ] && [ -n "$filter" ]; then
  echo "no repo under $ROOT matches '$1'" >&2
  exit 1
fi

# Align columns on the plain text, then color each cell, so escape codes never
# throw off the widths.
{
  printf 'REPO\tWHERE\tREMOTE\tLAST\tFLAGS\n'
  printf '%s' "$rows"
} | awk -F '\t' -v color="$color" '
function c(code, s) { return color ? "\033[" code "m" s "\033[0m" : s }
function pad(n,   s) { s = ""; while (n-- > 0) s = s " "; return s }
function paint(col, s, row,   i, n, t, out, parts) {
  if (row == 1) return c("1", s)
  if (col == 1) { i = index(s, "/"); return i ? c("2", substr(s, 1, i)) substr(s, i + 1) : s }
  if (col == 2) return s == "gitstack" ? c("32", s) : s == "github" ? c("34", s) : c("2", s)
  if (col == 4) return c("2", s)
  if (col == 5) {
    if (s == "-") return c("2", s)
    n = split(s, parts, " ")
    for (i = 1; i <= n; i++) {
      t = parts[i]
      if (t ~ /^!/) t = c("1;31", t)
      else if (t ~ /^(dirty|unpushed|behind):/) t = c("33", t)
      else t = c("2", t)
      out = out (i > 1 ? " " : "") t
    }
    return out
  }
  return s
}
{
  for (i = 1; i <= NF; i++) { cell[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) }
  if (NF > nf) nf = NF
}
END {
  for (r = 1; r <= NR; r++) {
    line = ""
    for (i = 1; i <= nf; i++) {
      line = line paint(i, cell[r, i], r)
      if (i < nf) line = line pad(w[i] - length(cell[r, i]) + 2)
    }
    print line
  }
}'

# Legend for the flags this table shows, only when a person is reading.
if [ -t 1 ]; then
  shown="$(printf '%s' "$rows" | cut -f5 | tr ' ' '\n' | sed 's/:.*//' | grep -v '^-*$' | sort -u | tr '\n' ' ')"
  if [ -n "$shown" ]; then
    echo
    print_flags $shown
  fi
fi
